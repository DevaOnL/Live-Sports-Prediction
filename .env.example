# Local database initialization. Use independent random passwords.
# Existing volume credentials do not change when this file is edited.
POSTGRES_DB=sports
POSTGRES_USER=sports_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=replace-with-a-random-postgres-password
MONGO_BOOTSTRAP_USER=bootstrap
MONGO_BOOTSTRAP_PASSWORD=replace-with-a-different-random-mongo-password

# Local administrative tooling. Keep these out of application containers.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_READER_PASSWORD=replace-with-a-random-reader-password
POSTGRES_WRITER_PASSWORD=replace-with-a-random-writer-password
POSTGRES_AUTH_PASSWORD=replace-with-a-random-auth-password
POSTGRES_MIGRATOR_PASSWORD=replace-with-a-random-migrator-password

# Archive administration stays in local tooling, never the worker container.
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=sports
MONGO_WORKER_USER=lsp_ingestion
MONGO_WORKER_PASSWORD=replace-with-a-random-archive-worker-password

# Enable only after explicit SQL migration and MongoDB provisioning.
INGESTION_ENABLED=false
APIFOOTBALL_API_KEY=

# Web sessions. Use one stable canonical origin and an independent random secret.
# HTTP is supported only for loopback development; deployed origins require HTTPS.
AUTH_BASE_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-an-independent-random-auth-secret
