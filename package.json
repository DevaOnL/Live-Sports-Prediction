{
  "name": "live-sports-prediction",
  "version": "1.0.0",
  "private": true,
  "description": "A SQL-first football prediction DBMS mini project.",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.8.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/build.mjs",
    "start": "next start --hostname 0.0.0.0",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker/index.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "db:provision": "node --env-file-if-exists=.env --import tsx scripts/db.ts provision",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/db.ts migrate",
    "test:db": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/database.test.ts",
    "mongo:provision": "node --env-file-if-exists=.env --import tsx scripts/mongo.ts",
    "ingest": "node --env-file-if-exists=.env --import tsx scripts/ingest.ts",
    "test:unit": "node --import tsx --test tests/ingestion.unit.test.ts tests/provider.test.ts tests/standings.test.ts tests/jobs.test.ts tests/forecast.test.ts tests/scouting.test.ts tests/worker.test.ts tests/http.test.ts tests/forecast-presentation.test.ts tests/evaluation.test.ts tests/prospective.test.ts tests/replay.test.ts tests/source-profiles.test.ts tests/sorare.test.ts",
    "test:ingestion": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/ingestion.database.test.ts",
    "forecast": "node --env-file-if-exists=.env --import tsx scripts/forecast.ts",
    "test:forecast": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/forecast.database.test.ts tests/forecast-jobs.database.test.ts",
    "test:reporting": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/reporting.database.test.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "users": "node --env-file-if-exists=.env --import tsx scripts/users.ts",
    "test:auth": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/auth.database.test.ts",
    "test:api": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/api-read.database.test.ts tests/api-admin.database.test.ts tests/api-http.database.test.ts",
    "test:ui": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/interface.browser.test.ts",
    "evaluate": "node --env-file-if-exists=.env --import tsx scripts/evaluate.ts",
    "test:evaluation": "node --import tsx --test --test-concurrency=1 tests/evaluation.database.test.ts tests/prospective.database.test.ts",
    "test:worker": "node --import tsx --test --test-concurrency=1 tests/worker.integration.test.ts",
    "test:accessibility": "node --import tsx --test --test-concurrency=1 tests/accessibility.browser.test.ts",
    "measure": "node --env-file-if-exists=.env --import tsx scripts/measure.ts",
    "replay": "node --env-file-if-exists=.env --import tsx scripts/replay.ts",
    "test:replay": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/replay.database.test.ts",
    "test:source": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/sorare.database.test.ts tests/sorare-read.database.test.ts tests/source-reporting.database.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "better-auth": "1.7.18",
    "mongodb": "7.8.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "playwright": "1.61.1",
    "typescript": "5.9.3"
  }
}
