{
  "name": "live-sports-prediction",
  "version": "0.1.0",
  "private": true,
  "description": "A SQL-first football prediction DBMS mini project.",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.8.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/build.mjs",
    "start": "next start --hostname 0.0.0.0",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker/index.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "db:provision": "node --env-file-if-exists=.env --import tsx scripts/db.ts provision",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/db.ts migrate",
    "test:db": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/database.test.ts",
    "mongo:provision": "node --env-file-if-exists=.env --import tsx scripts/mongo.ts",
    "ingest": "node --env-file-if-exists=.env --import tsx scripts/ingest.ts",
    "test:unit": "node --import tsx --test tests/ingestion.unit.test.ts tests/provider.test.ts tests/standings.test.ts tests/jobs.test.ts",
    "test:ingestion": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/ingestion.database.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "mongodb": "7.8.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "typescript": "5.9.3"
  }
}
